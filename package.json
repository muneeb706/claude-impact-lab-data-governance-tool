{
  "name": "data-governance-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Account, role and policy management for protecting proprietary scientific data",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"vite.config.ts.timestamp-*\" server/src/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "db:reset": "tsx server/src/reset.ts",
    "db:demo": "tsx server/src/seed-demo.ts",
    "test": "tsx --test server/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.67",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  }
}
